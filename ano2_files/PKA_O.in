#/atom 1 oxygen
#/atom 2 uranium
#/atom 3 fluorine
#/atom 4 cesium
# Teaching project: low-energy primary knock-on atom (PKA) in UO2
#
# REAL-TIME DAMAGE VISUALIZATION
# --------------------------------
# Type 1 = normal O
# Type 2 = normal U
# Type 3 = displaced O (displayed with fluorine styling)
# Type 4 = displaced U (displayed with cesium styling)
#
# IMPORTANT: Types 3 and 4 are ONLY visualization aliases.
# In the EAM mapping below they are mapped back to O and U respectively.
# Thus changing atom type for display does not change the intended O/U
# short-range species assignment.

boundary p p p
atom_style full
units metal

# ================================================================
# STUDENT CONTROLS
# ================================================================
variable EPKA equal 50.0       # PKA kinetic energy in eV
variable DX   equal 1.0        # direction x component
variable DY   equal 1.0        # direction y component
variable DZ   equal 0.0        # direction z component
variable DCUT equal 1.0        # highlight threshold in Angstrom
variable TEMP equal 300.0      # initial temperature in K
variable COLOR_EVERY equal 20  # recolor interval in timesteps
# ================================================================

# Reserve two extra types for displaced-O and displaced-U display aliases.
read_data AnO2-single_cell.lmpstruct extra/atom/types 2

variable O equal 1
variable U equal 2
variable O_DAMAGED equal 3
variable U_DAMAGED equal 4

set type ${O} charge -1.1104
set type ${U} charge  2.2208

kspace_style pppm 1.0e-5
variable SR_CUTOFF equal 11.0
pair_style hybrid/overlay coul/long ${SR_CUTOFF} eam/alloy
pair_coeff * * coul/long

# Type mapping:
# 1 -> O
# 2 -> U
# 3 -> O   (highlighted displaced oxygen)
# 4 -> U   (highlighted displaced uranium)
pair_coeff * * eam/alloy CeThUNpPuAmCmO.eam.alloy O U O U

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# Relax one unit cell, including its dimensions, then make a 4x4x4 cell.
fix relax all box/relax aniso 0.0 vmax 0.001
min_style cg/kk
min_modify line quadratic dmax 0.05
thermo 25
thermo_style custom step temp press pe etotal lx ly lz
minimize 1.0e-8 1.0e-10 2000 10000
unfix relax

replicate 4 4 4

# Pick one oxygen near the center.
variable XP equal xlo+0.4375*lx
variable YP equal ylo+0.4375*ly
variable ZP equal zlo+0.4375*lz
region pka_site sphere ${XP} ${YP} ${ZP} 0.35 units box

group oxygen type ${O}
group near_pka region pka_site
group pka intersect oxygen near_pka
group bath subtract all pka

variable NPKA equal count(pka)
print "PKA_CHECK: selected ${NPKA} atom (expected 1)"

# Brief thermal equilibration.
velocity all create ${TEMP} 160278 mom yes rot no dist gaussian
reset_timestep 0
timestep 0.001
fix equil all nvt temp ${TEMP} ${TEMP} 0.1
thermo 100
run 250
unfix equil

# Remove whole-cell drift before recoil.
velocity all zero linear

# Reference positions are established immediately before the recoil.
compute disp all displace/atom
compute msd all msd com yes
variable isdisp atom "c_disp[4] > v_DCUT"
compute ndisp all reduce sum v_isdisp
compute maxdisp all reduce max c_disp[4]
compute Tbath bath temp

# Dynamic visualization type.
#
# Current O-like atoms are types 1 or 3:
#   displacement <= DCUT -> type 1
#   displacement >  DCUT -> type 3
#
# Current U-like atoms are types 2 or 4:
#   displacement <= DCUT -> type 2
#   displacement >  DCUT -> type 4
#
# Using current type pairs (1,3) and (2,4) preserves species identity even
# after atoms have been recolored on a previous update.
variable vis_type atom "ternary((type==1)||(type==3),ternary(c_disp[4]>v_DCUT,3,1),ternary(c_disp[4]>v_DCUT,4,2))"

# Convert E_PKA [eV] to speed [Angstrom/ps].
variable MVV2E equal 1.0364269e-4
variable MPKA equal mass(pka)
variable DNORM equal sqrt(v_DX*v_DX+v_DY*v_DY+v_DZ*v_DZ)
variable VMAG equal sqrt(2.0*v_EPKA/(v_MPKA*v_MVV2E))
variable VX equal v_VMAG*v_DX/v_DNORM
variable VY equal v_VMAG*v_DY/v_DNORM
variable VZ equal v_VMAG*v_DZ/v_DNORM

print "PKA_SETUP: oxygen, E=${EPKA} eV, direction=(${DX},${DY},${DZ})"
print "PKA_SETUP: mass=${MPKA} g/mol, recoil speed=${VMAG} Angstrom/ps"
print "DAMAGE_COLOR: types 3/4 indicate displacement > ${DCUT} Angstrom"

# Add recoil to thermal velocity.
velocity pka set v_VX v_VY v_VZ sum yes units box

# Ballistic/cascade dynamics.
reset_timestep 0
timestep 0.00025
fix integrate all nve

variable KEPKA equal ke(pka)

thermo 40
thermo_style custom step time temp c_Tbath ke pe etotal c_msd[4] c_ndisp c_maxdisp v_KEPKA

# Output for spreadsheet/post-processing.
fix metrics all ave/time 10 1 10 c_msd[4] c_ndisp c_maxdisp v_KEPKA file pka_metrics.dat
fix pkaout all print 20 "$(step),$(time),$(c_msd[4]),$(c_ndisp),$(c_maxdisp)" file pka_history.csv screen no

dump traj all custom 20 pka_trajectory.lammpstrj id type x y z vx vy vz c_disp[4]
dump_modify traj sort id

# Recolor every COLOR_EVERY steps.
# set atom * type v_vis_type evaluates the atom-style variable independently
# for every atom.  Because types 3 and 4 map to O and U above, this is a
# visualization change rather than a species change in the EAM mapping.
run 2000 every ${COLOR_EVERY} "set atom * type v_vis_type"

unfix pkaout

variable FINAL_ND equal c_ndisp
variable FINAL_MSD equal c_msd[4]
variable FINAL_MAX equal c_maxdisp

print "=== PKA SIMULATION COMPLETE ===" screen yes
print "RESULT: EPKA=${EPKA} residual_displaced=${FINAL_ND} final_MSD_A2=${FINAL_MSD} max_displacement_A=${FINAL_MAX}" append pka_results.txt screen yes

unfix metrics
unfix integrate
undump traj
unfix metrics
unfix integrate
undump traj
